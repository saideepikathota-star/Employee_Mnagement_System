# ──────────────────────────────────────────────
# TechCorp HRMS — Combined .gitignore
# ──────────────────────────────────────────────

# ── Frontend (React / Node) ──────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ── Backend (Spring Boot / Maven) ────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.iml
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/

# ── IDE & OS ─────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
.DS_Store
Thumbs.db

# ── Secrets (never commit these!) ────────────
*.env
application-secret.properties
